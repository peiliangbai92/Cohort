# macOS metadata
.DS_Store

# R session artifacts
.Rhistory
.RData
.Ruserdata
Rplots.pdf

# Editor / IDE
.Rproj.user/
.vscode/
.claude/

# Intermediate run logs (regenerable via the aggregate_*.R scripts)
logs/
logs_master.log

# Raw EEG application data (Trujillo 2017, doi:10.18738/T8/EG0LJI, ~600 MB)
raw_data/

# Application reproduction caches (regenerable from raw_data via application/run_application.R)
application/cache/*
# ...but ship the processed EEG so the application reproduces without the raw BDFs
!application/cache/intervals.rds

# Keep committed result objects (simulation scenarios + comparison baselines)
!simulations/**/*.RData
!comparison/**/*.RData

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
